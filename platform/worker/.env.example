# =============================================================================
# Worker Service — Environment Configuration
# Copy this file to .env and fill in the values
# =============================================================================

# ── Infrastructure ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@postgres:5432/jobsystem
REDIS_URL=redis://redis:6379/0

# ── Worker Settings ─────────────────────────────────────────────────────────
WORKER_ID=worker-1
JOB_QUEUE_NAME=job_queue
QUEUE_POLL_TIMEOUT=5
MAX_RETRIES=3
PROCESSING_TIMEOUT=300

# ── Cache Settings ──────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# ── SupportRAG / Groq API ───────────────────────────────────────────────────
# Get your key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Groq rate limits (adjust to match your plan)
# Free tier (llama-3.3-70b-versatile): 30 req/min, 6 000 tokens/min
# Paid tier:                           600 req/min, 200 000 tokens/min
GROQ_REQUESTS_PER_MINUTE=30
GROQ_TOKENS_PER_MINUTE=6000

# ── Vector Store Settings ───────────────────────────────────────────────────
VECTOR_STORE_PATH=./data/vector_stores
# Set to false on Windows — faiss IVF can segfault with faiss-cpu
USE_VECTOR_STORE_IVF=false

# ── Debug ───────────────────────────────────────────────────────────────────
DEBUG=false
